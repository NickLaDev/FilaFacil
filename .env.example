# Copie para .env com `pnpm setup:env` — o script gera senhas e segredos aleatórios.
# Nunca versione o .env. Em produção, use o gerenciador de segredos da hospedagem.

NODE_ENV=development

# ─── PostgreSQL (docker compose) ────────────────────────────────────────────
POSTGRES_USER=filafacil
POSTGRES_PASSWORD=__GENERATE_PASSWORD__
POSTGRES_DB=filafacil
POSTGRES_PORT=5432
DATABASE_URL=postgresql://filafacil:__POSTGRES_PASSWORD__@localhost:5432/filafacil
# Banco usado por `pnpm test` (criado automaticamente pelo compose).
TEST_DATABASE_URL=postgresql://filafacil:__POSTGRES_PASSWORD__@localhost:5432/filafacil_test

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=3000
# Origem do frontend: CORS e retorno do login social.
WEB_ORIGIN=http://localhost:5173
# URL pública da API vista pelo navegador (em dev, via proxy do Vite). Base do redirect OAuth.
API_PUBLIC_URL=http://localhost:5173/api

# Sessão
JWT_ACCESS_SECRET=__GENERATE_SECRET__
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
# true em produção (HTTPS). Em localhost fica false para funcionar em qualquer navegador.
COOKIE_SECURE=false

# CPF: HMAC para unicidade/busca e chave AES-256-GCM (32 bytes em base64) para o valor protegido.
CPF_HMAC_SECRET=__GENERATE_SECRET__
CPF_ENCRYPTION_KEY=__GENERATE_KEY32__
# Códigos de verificação (OTP) são guardados só como HMAC com este segredo.
OTP_HMAC_SECRET=__GENERATE_SECRET__

# Envio de SMS/e-mail. `dev` escreve a mensagem no log da API (só fora de produção);
# `none` desliga o envio. Para produção, implemente um provider (ex.: Twilio, Zenvia, SES).
SMS_PROVIDER=dev
EMAIL_PROVIDER=dev

# Login social (OIDC). Deixe em branco para o provider responder "não configurado".
# Google: console.cloud.google.com → Credenciais → ID do cliente OAuth (aplicativo da Web).
#   URI de redirecionamento: ${API_PUBLIC_URL}/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: developer.apple.com → Identifiers (Services ID) + Keys (Sign in with Apple).
#   Return URL: ${API_PUBLIC_URL}/auth/oauth/apple/callback (exige HTTPS público)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Conteúdo do arquivo .p8, com quebras de linha escritas como \n.
APPLE_PRIVATE_KEY=

# Uploads de imagem (driver local em dev; troque por S3/R2/MinIO implementando FileStorage).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads
UPLOAD_MAX_BYTES=2097152

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Base da API usada pelo navegador. Em dev o Vite encaminha /api para VITE_API_PROXY_TARGET.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3000
