# Copie para .env com `pnpm setup:env` — o script gera senhas e segredos aleatórios.
# Nunca versione o .env. Em produção, use o gerenciador de segredos da hospedagem.

# NODE_ENV não fica aqui: este .env também é lido pelo Vite, e NODE_ENV=development nele
# faria `vite build` gerar um bundle de desenvolvimento. A API assume development quando
# a variável não existe; em produção defina NODE_ENV=production no ambiente do processo.

# ─── PostgreSQL (docker compose) ────────────────────────────────────────────
POSTGRES_USER=filafacil
POSTGRES_PASSWORD=__GENERATE_PASSWORD__
POSTGRES_DB=filafacil
POSTGRES_PORT=5432
DATABASE_URL=postgresql://filafacil:__POSTGRES_PASSWORD__@localhost:5432/filafacil
# Banco usado por `pnpm test` (criado automaticamente pelo compose).
TEST_DATABASE_URL=postgresql://filafacil:__POSTGRES_PASSWORD__@localhost:5432/filafacil_test

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=3000
# Origem do frontend: CORS e retorno do login social.
WEB_ORIGIN=http://localhost:5173
# URL pública da API vista pelo navegador (em dev, via proxy do Vite). Base do redirect OAuth.
API_PUBLIC_URL=http://localhost:5173/api

# Sessão
JWT_ACCESS_SECRET=__GENERATE_SECRET__
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
# true em produção (HTTPS). Em localhost fica false para funcionar em qualquer navegador.
COOKIE_SECURE=false

# CPF: HMAC para unicidade/busca e chave AES-256-GCM (32 bytes em base64) para o valor protegido.
CPF_HMAC_SECRET=__GENERATE_SECRET__
CPF_ENCRYPTION_KEY=__GENERATE_KEY32__
# Códigos de verificação (OTP) são guardados só como HMAC com este segredo.
OTP_HMAC_SECRET=__GENERATE_SECRET__

# Biometria (WebAuthn): domínio das credenciais. Vazio = host de WEB_ORIGIN (localhost em dev). A origem aceita é WEB_ORIGIN;
# em produção exige HTTPS. Trocar o valor invalida as credenciais já cadastradas.
WEBAUTHN_RP_ID=

# Envio de SMS/e-mail. `dev` escreve a mensagem no log da API (só fora de produção);
# `none` desliga o envio. E-mail real: EMAIL_PROVIDER=smtp (Nodemailer, variáveis SMTP_* abaixo).
# SMS real ainda não existe (nenhum provider contratado): com SMS_PROVIDER=none o app não oferece SMS.
SMS_PROVIDER=dev
EMAIL_PROVIDER=dev

# SMTP (EMAIL_PROVIDER=smtp). Ex. Gmail: smtp.gmail.com, porta 587, SMTP_SECURE=false, usuário = e-mail
# e SMTP_PASS = "senha de app" (conta Google com verificação em duas etapas). Porta 465 usa SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Pagamentos. PAYMENT_PROVIDER escolhe o gateway:
#   simulated  → DEMONSTRAÇÃO acadêmica, sem conta nem credencial. Nenhum dinheiro é movido e as transações
#                não têm valor financeiro (a tela e o comprovante dizem isso). Exige ALLOW_SIMULATED_PAYMENTS=true
#                e a API se recusa a subir assim com NODE_ENV=production.
#   mercadopago→ gateway real (futuro). Credenciais de teste: mercadopago.com.br/developers → Credenciais.
#                MP_ACCESS_TOKEN (SECRETO, só no servidor), MP_WEBHOOK_SECRET (assinatura do webhook) e a chave
#                PÚBLICA em VITE_MP_PUBLIC_KEY. PAYMENT_WEBHOOK_URL (túnel público) é opcional em dev local:
#                o app consulta o gateway sozinho enquanto o Pix está pendente.
#   none       → pagamento indisponível (503); nada é aprovado.
# O padrão do código é `none`; este exemplo liga o simulador para o ambiente local funcionar de imediato.
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=true
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_URL=

# Login social (OIDC). Deixe em branco para o provider responder "não configurado".
# Google: console.cloud.google.com → Credenciais → ID do cliente OAuth (aplicativo da Web).
#   URI de redirecionamento: ${API_PUBLIC_URL}/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: developer.apple.com → Identifiers (Services ID) + Keys (Sign in with Apple).
#   Return URL: ${API_PUBLIC_URL}/auth/oauth/apple/callback (exige HTTPS público)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Conteúdo do arquivo .p8, com quebras de linha escritas como \n.
APPLE_PRIVATE_KEY=

# Uploads de imagem (driver local em dev; troque por S3/R2/MinIO implementando FileStorage).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads
UPLOAD_MAX_BYTES=2097152

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Base da API usada pelo navegador. Em dev o Vite encaminha /api para VITE_API_PROXY_TARGET.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3000

# Chave PÚBLICA do Mercado Pago (tokeniza o cartão no navegador). Vazio = formulário de cartão desativado.
VITE_MP_PUBLIC_KEY=
