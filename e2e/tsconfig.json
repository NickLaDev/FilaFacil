{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "typeRoots": [
      "../apps/web/node_modules/@types",
      "../node_modules/@types"
    ]
  },
  "include": [
    "./**/*.ts",
    "../playwright.config.ts"
  ]
}