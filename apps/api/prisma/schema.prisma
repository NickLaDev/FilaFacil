// Banco da Sprint 1. Convenções:
// - tabelas e colunas em snake_case (@@map/@map); ids UUID gerados pelo banco;
// - toda data é timestamptz (UTC); a API devolve ISO 8601;
// - dinheiro em centavos (Int); custos de insumo/quantidades em Decimal.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Identidade ─────────────────────────────────────────────────────────────

enum UserRole {
  client
  attendant
  manager
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended

  @@map("user_status")
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  name                  String     @db.VarChar(120)
  /// Sempre minúsculo (normalizado pela API).
  email                 String?    @unique @db.VarChar(254)
  /// Só dígitos, com DDD.
  phone                 String?    @unique @db.VarChar(11)
  passwordHash          String?    @map("password_hash")
  /// HMAC-SHA256 do CPF normalizado: garante unicidade e permite busca sem guardar o CPF em claro.
  cpfHash               String?    @unique @map("cpf_hash") @db.Char(64)
  /// CPF cifrado com AES-256-GCM (formato v1:iv:tag:dados, base64). Só decifrado quando estritamente necessário.
  cpfEncrypted          String?    @map("cpf_encrypted")
  /// Versão exibível (***.***.123-45).
  cpfMasked             String?    @map("cpf_masked") @db.VarChar(14)
  role                  UserRole   @default(client)
  status                UserStatus @default(active)
  emailVerifiedAt       DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt       DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  termsAcceptedAt       DateTime?  @map("terms_accepted_at") @db.Timestamptz(3)
  marketingOptIn        Boolean    @default(false) @map("marketing_opt_in")
  /// Onboarding do primeiro acesso concluído ou pulado (ficha 07); lembrado por conta.
  onboardingCompletedAt DateTime?  @map("onboarding_completed_at") @db.Timestamptz(3)
  /// Restrições alimentares e alergias do cliente (ficha 64): chaves do catálogo `ALLERGENS` em @filafacil/shared.
  dietaryRestrictions   String[]   @default([]) @map("dietary_restrictions")
  lastAccessAt          DateTime?  @map("last_access_at") @db.Timestamptz(3)
  /// Conta excluída a pedido do titular (LGPD): dados pessoais anonimizados, pedidos mantidos sem identificação.
  deletedAt             DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions         UserPermission[]
  memberships         EstablishmentMembership[]
  addresses           UserAddress[]
  sessions            Session[]
  authAccounts        AuthAccount[]
  availabilityChanges MenuItemAvailabilityChange[]
  auditAsTarget       PermissionAuditLog[]         @relation("AuditTarget")
  auditAsActor        PermissionAuditLog[]         @relation("AuditActor")
  floorPlanUpdates    FloorPlan[]
  waitlistEntries     WaitlistEntry[]              @relation("WaitlistCreatedBy")
  customerWaitlist    WaitlistEntry[]              @relation("WaitlistCustomer")
  orders              Order[]
  otpChallenges       OtpChallenge[]
  favorites           Favorite[]
  passkeys            Passkey[]
  webauthnChallenges  WebAuthnChallenge[]
  tableCalls          TableCall[]
  loyaltyEntries      LoyaltyLedgerEntry[]
  cashbackEntries     CashbackEntry[]
  couponRedemptions   CouponRedemption[]
  paymentMethods      SavedPaymentMethod[]
  bookings            Booking[]
  reviews             Review[]
  notifications       AppNotification[]
  supportTickets      SupportTicket[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

/// Permissões efetivas do usuário (chaves do catálogo em @filafacil/shared), editáveis pelo admin.
model UserPermission {
  userId     String   @map("user_id") @db.Uuid
  permission String   @db.VarChar(64)
  grantedAt  DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permissions")
}

/// Vínculo de atendentes e gestores com os estabelecimentos em que trabalham.
model EstablishmentMembership {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([userId, establishmentId])
  @@index([establishmentId])
  @@map("establishment_memberships")
}

model UserAddress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String   @db.VarChar(40)
  street    String   @db.VarChar(160)
  city      String   @db.VarChar(80)
  /// No máximo um endereço padrão por usuário (índice único parcial na migration).
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

/// Sessão persistente (um aparelho/navegador). O refresh token só existe como hash SHA-256.
model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique @map("refresh_token_hash") @db.Char(64)
  /// Token anterior à última rotação: aceito por alguns segundos (abas concorrentes); depois disso, reuso revoga a sessão.
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") @db.Char(64)
  rotatedAt                DateTime? @map("rotated_at") @db.Timestamptz(3)
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt               DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason            String?   @map("revoked_reason") @db.VarChar(40)
  userAgent                String?   @map("user_agent") @db.VarChar(255)
  ipAddress                String?   @map("ip_address") @db.VarChar(64)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([previousRefreshTokenHash])
  @@map("sessions")
}

enum OtpChannel {
  phone
  email

  @@map("otp_channel")
}

/// Para que o código foi emitido: um código de verificação de contato não abre sessão, e vice-versa.
enum OtpPurpose {
  login
  contact_verification
  password_reset
  account_deletion
  passkey_registration

  @@map("otp_purpose")
}

/// Desafio de código de uso único. O código nunca é salvo: só o HMAC.
model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  channel     OtpChannel
  purpose     OtpPurpose @default(login)
  /// Dono do desafio (verificação de contato: só ele pode confirmar o código).
  userId      String?    @map("user_id") @db.Uuid
  destination String     @db.VarChar(254)
  codeHash    String     @map("code_hash") @db.Char(64)
  attempts    Int        @default(0)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  ipAddress   String?    @map("ip_address") @db.VarChar(64)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channel, destination, createdAt])
  @@index([userId])
  @@map("otp_challenges")
}

enum AuthProvider {
  google
  apple

  @@map("auth_provider")
}

/// Identidade externa (Google/Apple) vinculada a um usuário.
model AuthAccount {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject") @db.VarChar(255)
  email           String?      @db.VarChar(254)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_accounts")
}

/// Estado de um login social em andamento (state + PKCE + nonce). Uso único, expira em minutos.
model OAuthState {
  state        String       @id @db.VarChar(128)
  provider     AuthProvider
  codeVerifier String       @map("code_verifier") @db.VarChar(128)
  nonce        String       @db.VarChar(128)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("oauth_states")
}

/// Credencial WebAuthn (biometria/passkey) de um aparelho. Só a chave pública é guardada.
model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  credentialId String    @unique @map("credential_id") @db.VarChar(512)
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceName   String    @default("Este aparelho") @map("device_name") @db.VarChar(60)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

enum WebAuthnPurpose {
  registration
  authentication

  @@map("webauthn_purpose")
}

/// Desafio WebAuthn emitido pelo servidor. Uso único e curto: é apagado ao ser verificado.
model WebAuthnChallenge {
  id        String          @id @default(uuid()) @db.Uuid
  purpose   WebAuthnPurpose
  /// Registro: dono do desafio. Login: nulo (credencial descoberta pelo aparelho).
  userId    String?         @map("user_id") @db.Uuid
  challenge String          @db.VarChar(256)
  expiresAt DateTime        @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

// ─── Planos ─────────────────────────────────────────────────────────────────

enum PlanFeature {
  floor_plan
  waitlist
  promotions
  recipes
  layout_duplication

  @@map("plan_feature")
}

model Plan {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique @db.VarChar(40)
  monthlyPriceCents Int      @map("monthly_price_cents")
  maxUnits          Int      @map("max_units")
  maxTables         Int      @map("max_tables")
  maxStaff          Int      @map("max_staff")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  features       PlanFeatureGrant[]
  establishments Establishment[]

  @@map("plans")
}

/// Recursos liberados por plano: fonte única dos entitlements checados pela API.
model PlanFeatureGrant {
  planId  String      @map("plan_id") @db.Uuid
  feature PlanFeature

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, feature])
  @@map("plan_features")
}

// ─── Estabelecimentos ───────────────────────────────────────────────────────

enum EstablishmentStatus {
  active
  inactive
  suspended

  @@map("establishment_status")
}

enum EstablishmentType {
  bar
  restaurant
  canteen
  snack_bar

  @@map("establishment_type")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishments Establishment[]

  @@map("organizations")
}

model Establishment {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  planId             String              @map("plan_id") @db.Uuid
  name               String              @db.VarChar(80)
  type               EstablishmentType
  status             EstablishmentStatus @default(active)
  city               String              @db.VarChar(60)
  address            String              @db.VarChar(160)
  latitude           Float
  longitude          Float
  /// Fuso IANA usado para horário de funcionamento (ex.: America/Sao_Paulo).
  timezone           String              @default("America/Sao_Paulo") @db.VarChar(64)
  foodCategories     String[]            @default([]) @map("food_categories")
  tags               String[]            @default([])
  /// Agregado exibido na página do restaurante (não há fluxo de avaliação nas Sprints 1–2).
  ratingAverage      Decimal             @default(0) @map("rating_average") @db.Decimal(2, 1)
  ratingCount        Int                 @default(0) @map("rating_count")
  /// Soma das notas (ficha 48): a média é sempre ratingSum / ratingCount, sem acumular erro de arredondamento.
  ratingSum          Int                 @default(0) @map("rating_sum")
  /// Antecedência (dias) do alerta de lote perto do vencimento (ficha 70); mínimo 3.
  expiryAlertDays    Int                 @default(7) @map("expiry_alert_days")
  /// Tempo médio de espera informado pela casa — base do filtro "menor espera".
  averageWaitMinutes Int                 @default(15) @map("average_wait_minutes")
  ordersPaused       Boolean             @default(false) @map("orders_paused")
  highDemand         Boolean             @default(false) @map("high_demand")
  /// Onde o cliente retira o pedido pronto (ex.: "Balcão 2").
  pickupPoint        String              @default("Balcão") @map("pickup_point") @db.VarChar(60)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan              Plan                         @relation(fields: [planId], references: [id], onDelete: Restrict)
  photos            EstablishmentPhoto[]
  openingHours      OpeningHour[]
  memberships       EstablishmentMembership[]
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  promotions        Promotion[]
  ingredients       Ingredient[]
  floorPlan         FloorPlan?
  diningTables      DiningTable[]
  waitlistEntries   WaitlistEntry[]
  availabilityLog   MenuItemAvailabilityChange[]
  orders            Order[]
  favoritedBy       Favorite[]
  tableCalls        TableCall[]
  tableGroups       TableGroup[]
  tableReservations TableReservation[]
  itemRankings      MenuItemRanking[]
  kitchenStations   KitchenStation[]
  printers          Printer[]
  shifts            Shift[]
  tabs              Tab[]
  staffAlerts       StaffAlert[]
  cashbackRules     CashbackRule[]
  coupons           Coupon[]
  bookings          Booking[]
  reviews           Review[]
  notifications     AppNotification[]
  shareVisits       ShareVisit[]
  supportTickets    SupportTicket[]
  integrations      Integration[]
  incidents         Incident[]
  invoices          Invoice[]
  changeLog         EstablishmentChange[]

  @@index([status, latitude, longitude])
  @@index([organizationId])
  @@index([planId])
  @@map("establishments")
}

/// Restaurantes favoritos da conta (sincronizados entre aparelhos).
model Favorite {
  userId          String   @map("user_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@id([userId, establishmentId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorites")
}

model EstablishmentPhoto {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  url             String   @db.VarChar(500)
  /// Chave no storage quando a foto foi enviada pela plataforma (null para links externos).
  storageKey      String?  @map("storage_key") @db.VarChar(128)
  position        Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, position])
  @@map("establishment_photos")
}

/// Faixa de funcionamento em minutos desde a meia-noite, no fuso do estabelecimento.
/// closes_at <= opens_at significa que a faixa termina no dia seguinte.
model OpeningHour {
  id              String @id @default(uuid()) @db.Uuid
  establishmentId String @map("establishment_id") @db.Uuid
  weekday         Int    @db.SmallInt
  opensAt         Int    @map("opens_at") @db.SmallInt
  closesAt        Int    @map("closes_at") @db.SmallInt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, weekday])
  @@map("opening_hours")
}

// ─── Cardápio ───────────────────────────────────────────────────────────────

model MenuCategory {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String   @db.VarChar(40)
  position        Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  items         MenuItem[]

  @@unique([establishmentId, name])
  @@map("menu_categories")
}

model MenuItem {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  name            String    @db.VarChar(80)
  description     String    @default("") @db.VarChar(200)
  priceCents      Int       @map("price_cents")
  imageUrl        String?   @map("image_url") @db.VarChar(500)
  imageStorageKey String?   @map("image_storage_key") @db.VarChar(128)
  available       Boolean   @default(true)
  position        Int
  /// Exclusão lógica: o item some do cardápio, mas o histórico (disponibilidade, futuros pedidos) continua íntegro.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Destaque manual do gestor (ficha 46).
  highlighted     Boolean   @default(false)
  /// Alérgenos do item (ficha 64): chaves do catálogo `ALLERGENS` em @filafacil/shared.
  allergens       String[]  @default([])
  /// Estação da cozinha que prepara o item (ficha 24); nulo = estação implícita "Geral".
  stationId       String?   @map("station_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  station             KitchenStation?              @relation(fields: [stationId], references: [id], onDelete: SetNull)
  ranking             MenuItemRanking?
  establishment       Establishment                @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category            MenuCategory                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  availabilityChanges MenuItemAvailabilityChange[]
  promotionItems      PromotionItem[]
  technicalSheet      TechnicalSheet?
  orderItems          OrderItem[]

  @@index([establishmentId, deletedAt, available])
  @@index([categoryId])
  @@map("menu_items")
}

/// Ranking semanal dos itens mais pedidos (ficha 46): pedidos pagos dos últimos 30 dias, recalculado toda semana.
model MenuItemRanking {
  menuItemId      String   @id @map("menu_item_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  rank            Int
  quantity        Int
  calculatedAt    DateTime @map("calculated_at") @db.Timestamptz(3)

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, rank])
  @@map("menu_item_rankings")
}

/// Registro da última execução do recálculo semanal (uma linha, id = 1): evita recalcular a cada reinício.
model RankingRun {
  id    Int      @id
  ranAt DateTime @map("ran_at") @db.Timestamptz(3)

  @@map("ranking_runs")
}

model MenuItemAvailabilityChange {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  menuItemId      String   @map("menu_item_id") @db.Uuid
  /// Nome no momento da alteração (o item pode ser renomeado depois).
  itemName        String   @map("item_name") @db.VarChar(80)
  available       Boolean
  changedById     String   @map("changed_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  changedBy     User          @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([establishmentId, createdAt(sort: Desc)])
  @@index([menuItemId])
  @@map("menu_item_availability_changes")
}

// ─── Promoções ──────────────────────────────────────────────────────────────

/// Vigência derivada do período (starts_at <= agora <= ends_at): sem job para ligar/desligar.
model Promotion {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String   @db.VarChar(60)
  discountPercent Int      @map("discount_percent") @db.SmallInt
  startsAt        DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  items         PromotionItem[]
  cashbackRules CashbackRule[]

  @@index([establishmentId, startsAt, endsAt])
  @@map("promotions")
}

model PromotionItem {
  promotionId String @map("promotion_id") @db.Uuid
  menuItemId  String @map("menu_item_id") @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([promotionId, menuItemId])
  @@index([menuItemId])
  @@map("promotion_items")
}

// ─── Fichas técnicas ────────────────────────────────────────────────────────

enum IngredientUnit {
  un
  kg
  g
  L
  ml

  @@map("ingredient_unit")
}

model Ingredient {
  id               String         @id @default(uuid()) @db.Uuid
  establishmentId  String         @map("establishment_id") @db.Uuid
  name             String         @db.VarChar(60)
  unit             IngredientUnit
  /// Custo por unidade de medida (R$), com até 4 casas.
  unitCost         Decimal        @map("unit_cost") @db.Decimal(12, 4)
  /// Estoque atual (ficha 50); nulo = insumo sem controle de estoque.
  stockQuantity    Decimal?       @map("stock_quantity") @db.Decimal(14, 4)
  /// Alerta quando o estoque atual fica menor ou igual a este valor.
  minStockQuantity Decimal        @default(0) @map("min_stock_quantity") @db.Decimal(14, 4)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  sheetItems    TechnicalSheetItem[]
  movements     StockMovement[]
  lots          IngredientLot[]

  @@unique([establishmentId, name])
  @@map("ingredients")
}

/// Uma ficha por item do cardápio. O custo total não é gravado: é calculado na leitura
/// a partir do custo atual dos insumos, então mudar um insumo recalcula todos os pratos.
model TechnicalSheet {
  id               String   @id @default(uuid()) @db.Uuid
  menuItemId       String   @unique @map("menu_item_id") @db.Uuid
  costLimitPercent Decimal  @map("cost_limit_percent") @db.Decimal(5, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  menuItem MenuItem             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  items    TechnicalSheetItem[]

  @@map("technical_sheets")
}

model TechnicalSheetItem {
  technicalSheetId String  @map("technical_sheet_id") @db.Uuid
  ingredientId     String  @map("ingredient_id") @db.Uuid
  quantity         Decimal @db.Decimal(12, 4)

  technicalSheet TechnicalSheet @relation(fields: [technicalSheetId], references: [id], onDelete: Cascade)
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([technicalSheetId, ingredientId])
  @@index([ingredientId])
  @@map("technical_sheet_items")
}

// ─── Salão ──────────────────────────────────────────────────────────────────

model FloorPlan {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @unique @map("establishment_id") @db.Uuid
  version         Int      @default(1)
  updatedById     String?  @map("updated_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  updatedBy     User?         @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  tables        DiningTable[]

  @@map("floor_plans")
}

enum TableShape {
  round
  square
  rect

  @@map("table_shape")
}

/// Ocupação mínima exigida pela fila de espera (ficha 21): estimativa e aviso ao liberar mesa.
enum TableOccupancy {
  free
  occupied

  @@map("table_occupancy")
}

model DiningTable {
  id                String         @id @default(uuid()) @db.Uuid
  floorPlanId       String         @map("floor_plan_id") @db.Uuid
  /// Redundante com floor_plans: permite filtrar e autorizar por estabelecimento sem join.
  establishmentId   String         @map("establishment_id") @db.Uuid
  label             String         @db.VarChar(30)
  shape             TableShape
  capacity          Int            @db.SmallInt
  /// Centro da mesa em % da área da planta (0–100).
  positionX         Float          @map("position_x")
  positionY         Float          @map("position_y")
  /// Código único impresso no QR Code da mesa (gerado pelo servidor).
  qrCode            String         @unique @map("qr_code") @db.VarChar(32)
  occupancy         TableOccupancy @default(free)
  occupiedPartySize Int?           @map("occupied_party_size") @db.SmallInt
  occupiedSince     DateTime?      @map("occupied_since") @db.Timestamptz(3)
  /// Mesas mescladas (ficha 47) compartilham o mesmo grupo; sair do grupo restaura a mesa individual.
  groupId           String?        @map("group_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  floorPlan     FloorPlan          @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  establishment Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders        Order[]
  group         TableGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  calls         TableCall[]
  reservations  TableReservation[]
  bookings      Booking[]
  tabs          Tab[]

  @@unique([floorPlanId, label])
  @@index([establishmentId, occupancy])
  @@index([groupId])
  @@map("dining_tables")
}

/// Mesas mescladas numa só unidade (capacidade somada, uma conta). Desfazer apaga o grupo.
model TableGroup {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  tables        DiningTable[]

  @@index([establishmentId])
  @@map("table_groups")
}

/// Chamado de atendimento feito pelo cliente. Aberto até a equipe resolver.
model TableCall {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  tableId         String    @map("table_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedById    String?   @map("resolved_by_id") @db.Uuid

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  table         DiningTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// No máximo um chamado aberto por mesa (índice parcial na migration).
  @@index([tableId, resolvedAt])
  @@index([establishmentId, resolvedAt])
  @@map("table_calls")
}

/// Reserva de mesa feita pela equipe. A mesa fica "reservada" até a reserva ser cancelada ou a mesa ser ocupada.
model TableReservation {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  tableId         String    @map("table_id") @db.Uuid
  name            String    @db.VarChar(80)
  partySize       Int       @map("party_size") @db.SmallInt
  reservedAt      DateTime  @map("reserved_at") @db.Timestamptz(3)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(3)
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  table         DiningTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, closedAt])
  @@index([establishmentId, closedAt])
  @@map("table_reservations")
}

// ─── Fila de espera ─────────────────────────────────────────────────────────

enum WaitlistStatus {
  waiting
  notified
  seated
  removed

  @@map("waitlist_status")
}

model WaitlistEntry {
  id                 String         @id @default(uuid()) @db.Uuid
  establishmentId    String         @map("establishment_id") @db.Uuid
  name               String         @db.VarChar(80)
  phone              String         @db.VarChar(11)
  partySize          Int            @map("party_size") @db.SmallInt
  /// Ordem na fila. Única entre as entradas ativas (waiting/notified) — índice parcial na migration.
  position           Int
  status             WaitlistStatus @default(waiting)
  quotedWaitMinutes  Int            @map("quoted_wait_minutes")
  joinedAt           DateTime       @default(now()) @map("joined_at") @db.Timestamptz(3)
  notifiedAt         DateTime?      @map("notified_at") @db.Timestamptz(3)
  notifiedTableLabel String?        @map("notified_table_label") @db.VarChar(60)
  /// Mesas liberadas para o grupo no aviso; ocupadas quando o grupo senta.
  notifiedTableIds   String[]       @default([]) @map("notified_table_ids") @db.Uuid
  closedAt           DateTime?      @map("closed_at") @db.Timestamptz(3)
  createdById        String?        @map("created_by_id") @db.Uuid
  /// Cliente que entrou na fila pelo botão "Reservar" da página do restaurante (ficha 12); nulo quando a equipe cadastrou.
  customerId         String?        @map("customer_id") @db.Uuid
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  createdBy     User?                  @relation("WaitlistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  customer      User?                  @relation("WaitlistCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  notifications WaitlistNotification[]

  @@index([establishmentId, status, position])
  @@index([customerId, status])
  @@map("waitlist_entries")
}

enum NotificationStatus {
  sent
  failed
  skipped

  @@map("notification_status")
}

/// Registro de cada aviso de "mesa pronta" (canal, destino mascarado e resultado do provider).
model WaitlistNotification {
  id                String             @id @default(uuid()) @db.Uuid
  entryId           String             @map("entry_id") @db.Uuid
  channel           String             @db.VarChar(20)
  destinationMasked String             @map("destination_masked") @db.VarChar(40)
  tableLabel        String?            @map("table_label") @db.VarChar(60)
  status            NotificationStatus
  provider          String             @db.VarChar(40)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  entry WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("waitlist_notifications")
}

// ─── Pedidos e pagamentos ───────────────────────────────────────────────────

enum OrderStatus {
  /// Criado e aguardando pagamento.
  received
  paid
  preparing
  ready
  delivered
  cancelled

  @@map("order_status")
}

enum PaymentMethod {
  pix
  credit
  debit

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  approved
  refused
  expired
  cancelled
  refunded

  @@map("payment_status")
}

model Order {
  id                       String      @id @default(uuid()) @db.Uuid
  /// Número exibido ao cliente ("PEDIDO #184").
  number                   Int         @unique @default(autoincrement())
  userId                   String      @map("user_id") @db.Uuid
  establishmentId          String      @map("establishment_id") @db.Uuid
  /// Mesa do QR Code. Se a mesa for removida da planta, o pedido continua com o nome em `tableLabel`.
  tableId                  String?     @map("table_id") @db.Uuid
  tableLabel               String?     @map("table_label") @db.VarChar(30)
  /// Gerado pelo app a cada tentativa de checkout: reenviar o pedido não o duplica.
  clientRequestId          String?     @map("client_request_id") @db.VarChar(64)
  status                   OrderStatus @default(received)
  /// Total calculado pelo servidor (preços e promoções vigentes na criação).
  totalCents               Int         @map("total_cents")
  pickupCode               String      @map("pickup_code") @db.Char(4)
  /// Desconto de pontos FilaZero Club (ficha 14); `totalCents` já é o valor líquido a pagar.
  discountCents            Int         @default(0) @map("discount_cents")
  redeemedPoints           Int         @default(0) @map("redeemed_points")
  /// Saldo de cashback usado no pedido (ficha 15) e cupom aplicado (ficha 56); `totalCents` já é o líquido.
  cashbackUsedCents        Int         @default(0) @map("cashback_used_cents")
  couponId                 String?     @map("coupon_id") @db.Uuid
  couponCode               String?     @map("coupon_code") @db.VarChar(32)
  couponDiscountCents      Int         @default(0) @map("coupon_discount_cents")
  /// Cashback a ser creditado na entrega, congelado na criação do pedido (regra vigente naquele momento).
  cashbackEarnCents        Int         @default(0) @map("cashback_earn_cents")
  cashbackRuleId           String?     @map("cashback_rule_id") @db.Uuid
  /// Tempo estimado ajustado pelo gestor (ficha 63); nulo = tempo médio da casa.
  estimatedMinutesOverride Int?        @map("estimated_minutes_override")
  estimateAdjustedAt       DateTime?   @map("estimate_adjusted_at") @db.Timestamptz(3)
  estimateAdjustedById     String?     @map("estimate_adjusted_by_id") @db.Uuid
  /// Comanda a que o pedido foi atribuído (ficha 17); pagamento posterior.
  tabId                    String?     @map("tab_id") @db.Uuid
  /// Pedido atribuído à comanda quitado no fechamento da comanda (ficha 22).
  tabSettledAt             DateTime?   @map("tab_settled_at") @db.Timestamptz(3)
  paidAt                   DateTime?   @map("paid_at") @db.Timestamptz(3)
  preparingAt              DateTime?   @map("preparing_at") @db.Timestamptz(3)
  readyAt                  DateTime?   @map("ready_at") @db.Timestamptz(3)
  deliveredAt              DateTime?   @map("delivered_at") @db.Timestamptz(3)
  cancelledAt              DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  /// Quem cancelou (nulo = cliente ou sistema) e por quê.
  cancelledById            String?     @map("cancelled_by_id") @db.Uuid
  cancelReason             String?     @map("cancel_reason") @db.VarChar(60)
  /// Baixa de estoque feita (ficha 50): garante uma única baixa por pedido.
  stockConsumedAt          DateTime?   @map("stock_consumed_at") @db.Timestamptz(3)
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tab              Tab?                 @relation(fields: [tabId], references: [id], onDelete: SetNull)
  notifications    OrderNotification[]
  loyaltyEntries   LoyaltyLedgerEntry[]
  cashbackEntries  CashbackEntry[]
  couponRedemption CouponRedemption?
  review           Review?
  stockMovements   StockMovement[]
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  establishment    Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  table            DiningTable?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([establishmentId, status, createdAt])
  @@index([tabId])
  @@map("orders")
}

/// Cópia do item no momento do pedido: nome e preço não mudam se o cardápio mudar depois.
model OrderItem {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  menuItemId     String    @map("menu_item_id") @db.Uuid
  name           String    @db.VarChar(80)
  unitPriceCents Int       @map("unit_price_cents")
  quantity       Int       @db.SmallInt
  notes          String    @default("") @db.VarChar(200)
  /// Estação do item no momento do pedido (nulo = "Geral") e quando ficou pronto (ficha 24).
  stationId      String?   @map("station_id") @db.Uuid
  readyAt        DateTime? @map("ready_at") @db.Timestamptz(3)

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  station  KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
  @@index([stationId])
  @@map("order_items")
}

/// Tentativa de pagamento no gateway. Só o gateway muda o status para aprovado/estornado.
/// A linha é gravada ANTES de chamar o gateway e seu id é a referência externa e a chave de idempotência:
/// `pending` sem `providerPaymentId` = resultado incerto, conciliado pelo servidor (nunca descartado).
/// Índice parcial (migration): no máximo um pagamento `pending` ou `approved` por pedido.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  /// 1, 2, 3… por pedido; compõe a chave de idempotência enviada ao gateway.
  attempt           Int
  method            PaymentMethod
  status            PaymentStatus @default(pending)
  amountCents       Int           @map("amount_cents")
  providerPaymentId String?       @unique @map("provider_payment_id") @db.VarChar(64)
  pixCopyPaste      String?       @map("pix_copy_paste")
  pixQrBase64       String?       @map("pix_qr_base64")
  pixExpiresAt      DateTime?     @map("pix_expires_at") @db.Timestamptz(3)
  failureReason     String?       @map("failure_reason") @db.VarChar(120)
  approvedAt        DateTime?     @map("approved_at") @db.Timestamptz(3)
  /// Estorno pedido ao gateway e ainda não confirmado: a idempotência e a conciliação dependem disto.
  refundRequestedAt DateTime?     @map("refund_requested_at") @db.Timestamptz(3)
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, attempt])
  @@map("payments")
}

// ─── Auditoria ──────────────────────────────────────────────────────────────

enum PermissionAuditAction {
  role_changed
  permissions_changed
  memberships_changed
  suspended
  reactivated

  @@map("permission_audit_action")
}

model PermissionAuditLog {
  id           String                @id @default(uuid()) @db.Uuid
  targetUserId String                @map("target_user_id") @db.Uuid
  actorId      String                @map("actor_id") @db.Uuid
  action       PermissionAuditAction
  description  String                @db.VarChar(2000)
  before       Json
  after        Json
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  targetUser User @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  actor      User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("permission_audit_logs")
}

// ─── Sprint 3 ───────────────────────────────────────────────────────────────

/// Estação da cozinha (ficha 24), ex.: Chapa, Bar. Itens sem estação pertencem à "Geral" implícita.
model KitchenStation {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String   @db.VarChar(40)
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  menuItems     MenuItem[]
  orderItems    OrderItem[]
  printers      Printer[]

  @@unique([establishmentId, name])
  @@map("kitchen_stations")
}

/// Impressora da cozinha com heartbeat (ficha 26): sem sinal por 60 s = offline. Hardware real não é testado.
model Printer {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  stationId       String?   @map("station_id") @db.Uuid
  name            String    @db.VarChar(60)
  /// SHA-256 da chave do dispositivo (a chave só é mostrada uma vez, na criação).
  keyHash         String    @map("key_hash") @db.Char(64)
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  station       KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@unique([establishmentId, name])
  @@index([keyHash])
  @@map("printers")
}

enum StaffAlertKind {
  printer_offline
  low_stock
  tab_refund_pending
  stock_shortfall
  ingredient_expiring

  @@map("staff_alert_kind")
}

/// Alerta in-app para a equipe (impressora offline, estoque baixo). No máximo um aberto por (tipo, referência).
model StaffAlert {
  id              String         @id @default(uuid()) @db.Uuid
  establishmentId String         @map("establishment_id") @db.Uuid
  kind            StaffAlertKind
  /// Id do objeto do alerta (impressora ou insumo).
  refId           String         @map("ref_id") @db.Uuid
  message         String         @db.VarChar(200)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt      DateTime?      @map("resolved_at") @db.Timestamptz(3)
  /// Dispensado pela equipe: some do painel e não reabre até a condição normalizar (resolvedAt).
  dismissedAt     DateTime?      @map("dismissed_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  /// Índice parcial (migration): um alerta aberto por (tipo, referência).
  @@index([establishmentId, resolvedAt])
  @@map("staff_alerts")
}

/// Turno de trabalho (ficha 25): aberto e fechado pelo gestor; um turno aberto por estabelecimento.
model Shift {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  openedAt        DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(3)
  openedById      String?   @map("opened_by_id") @db.Uuid
  closedById      String?   @map("closed_by_id") @db.Uuid

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, openedAt(sort: Desc)])
  @@map("shifts")
}

enum TabStatus {
  open
  closed

  @@map("tab_status")
}

/// Comanda da mesa ou do grupo mesclado (ficha 17). Índice parcial (migration): uma aberta por escopo.
model Tab {
  id                    String    @id @default(uuid()) @db.Uuid
  establishmentId       String    @map("establishment_id") @db.Uuid
  /// Mesa âncora (a primeira por rótulo do escopo) e chave do escopo: id do grupo ou da mesa.
  tableId               String?   @map("table_id") @db.Uuid
  scopeKey              String    @map("scope_key") @db.VarChar(40)
  label                 String    @db.VarChar(120)
  status                TabStatus @default(open)
  openedById            String?   @map("opened_by_id") @db.Uuid
  closedById            String?   @map("closed_by_id") @db.Uuid
  openedAt              DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt              DateTime? @map("closed_at") @db.Timestamptz(3)
  /// Totais congelados no fechamento (o saldo é sempre calculado na leitura enquanto a comanda está aberta).
  closedTotalCents      Int?      @map("closed_total_cents")
  closedPaidBeforeCents Int?      @map("closed_paid_before_cents")
  closedChargedCents    Int?      @map("closed_charged_cents")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  table         DiningTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orders        Order[]
  payments      TabPayment[]

  @@index([establishmentId, status])
  @@map("tabs")
}

/// Cobrança do saldo da comanda no fechamento (ficha 22). Idempotente por (comanda, chave).
/// Índice parcial (migration): no máximo uma `pending`/`approved` por comanda.
model TabPayment {
  id                String        @id @default(uuid()) @db.Uuid
  tabId             String        @map("tab_id") @db.Uuid
  idempotencyKey    String        @map("idempotency_key") @db.VarChar(64)
  method            PaymentMethod
  status            PaymentStatus @default(pending)
  amountCents       Int           @map("amount_cents")
  providerPaymentId String?       @unique @map("provider_payment_id") @db.VarChar(64)
  failureReason     String?       @map("failure_reason") @db.VarChar(120)
  createdById       String?       @map("created_by_id") @db.Uuid
  approvedAt        DateTime?     @map("approved_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tab Tab @relation(fields: [tabId], references: [id], onDelete: Restrict)

  @@unique([tabId, idempotencyKey])
  @@map("tab_payments")
}

/// Registro de cada aviso de pedido pronto por canal (ficha 05). Único por (pedido, canal): nunca duplica o envio.
model OrderNotification {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @map("order_id") @db.Uuid
  /// in_app | email | sms
  channel           String             @db.VarChar(20)
  kind              String             @default("order_ready") @db.VarChar(30)
  status            NotificationStatus
  provider          String             @db.VarChar(40)
  destinationMasked String?            @map("destination_masked") @db.VarChar(40)
  /// Código tipado da falha do provedor (sem detalhes sensíveis).
  errorCode         String?            @map("error_code") @db.VarChar(40)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind, channel])
  @@map("order_notifications")
}

enum LoyaltyEntryType {
  earn
  redeem
  redeem_return
  earn_reversal

  @@map("loyalty_entry_type")
}

/// Razão (ledger) do FilaZero Club (ficha 14). Pontos com sinal; único por (pedido, tipo) → idempotente.
model LoyaltyLedgerEntry {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  orderId   String           @map("order_id") @db.Uuid
  type      LoyaltyEntryType
  /// Positivo (earn, redeem_return) ou negativo (redeem, earn_reversal).
  points    Int
  note      String?          @db.VarChar(120)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, type])
  @@index([userId, createdAt(sort: Desc)])
  @@map("loyalty_ledger")
}

/// Movimentação de estoque de insumo (ficha 50): baixa por pedido (única por pedido+insumo) ou ajuste manual.
model StockMovement {
  id           String   @id @default(uuid()) @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  orderId      String?  @map("order_id") @db.Uuid
  /// Negativo na baixa; no ajuste, a diferença aplicada.
  quantity     Decimal  @db.Decimal(14, 4)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(14, 4)
  /// Quanto faltou (consumo maior que o estoque): ruptura sinalizada ao gestor.
  shortfall    Decimal  @default(0) @db.Decimal(14, 4)
  reason       String   @db.VarChar(20)
  actorId      String?  @map("actor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Índice parcial (migration): uma baixa por (pedido, insumo).
  @@index([ingredientId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

// ─── Sprint 4 ───────────────────────────────────────────────────────────────

/// Notificação in-app (fichas 30, 38, 39, 48, 70). Destinada a um cliente (`userId`) ou à equipe de um
/// estabelecimento (`establishmentId` + permissão). `dedupeKey` único impede avisos repetidos.
model AppNotification {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  establishmentId    String?   @map("establishment_id") @db.Uuid
  /// Permissão exigida da equipe para ver o aviso (nulo = qualquer membro da equipe).
  requiredPermission String?   @map("required_permission") @db.VarChar(64)
  kind               String    @db.VarChar(40)
  title              String    @db.VarChar(120)
  body               String    @db.VarChar(400)
  /// Objeto relacionado (reserva, pedido, chamado, fatura) para a tela abrir o detalhe.
  refId              String?   @map("ref_id") @db.Uuid
  dedupeKey          String?   @unique @map("dedupe_key") @db.VarChar(120)
  readAt             DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([establishmentId, createdAt(sort: Desc)])
  @@map("app_notifications")
}

/// Regra de cashback (ficha 15) por estabelecimento ou por promoção.
model CashbackRule {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String   @db.VarChar(60)
  percent         Int      @db.SmallInt
  /// Nulo = vale para todo o pedido; preenchido = só itens da promoção, enquanto ela estiver vigente.
  promotionId     String?  @map("promotion_id") @db.Uuid
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  promotion     Promotion?    @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([establishmentId, active])
  @@map("cashback_rules")
}

enum CashbackEntryType {
  earn
  redeem
  redeem_return
  earn_reversal

  @@map("cashback_entry_type")
}

/// Razão do saldo de cashback (ficha 15). Centavos com sinal; único por (pedido, tipo) → idempotente.
model CashbackEntry {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  orderId   String            @map("order_id") @db.Uuid
  type      CashbackEntryType
  cents     Int
  note      String?           @db.VarChar(120)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, type])
  @@index([userId, createdAt(sort: Desc)])
  @@map("cashback_ledger")
}

enum CouponDiscountType {
  percent
  fixed

  @@map("coupon_discount_type")
}

/// Cupom de campanha (ficha 56): código único por estabelecimento; uso único por cliente.
model Coupon {
  id              String             @id @default(uuid()) @db.Uuid
  establishmentId String             @map("establishment_id") @db.Uuid
  code            String             @db.VarChar(32)
  description     String             @default("") @db.VarChar(120)
  discountType    CouponDiscountType @map("discount_type")
  /// Percentual (1–100) ou centavos, conforme o tipo.
  discountValue   Int                @map("discount_value")
  minOrderCents   Int                @default(0) @map("min_order_cents")
  startsAt        DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime           @map("ends_at") @db.Timestamptz(3)
  /// Limite total de usos (nulo = ilimitado).
  maxUses         Int?               @map("max_uses")
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  redemptions   CouponRedemption[]

  @@unique([establishmentId, code])
  @@map("coupons")
}

/// Uso do cupom por um cliente. Único por (cupom, cliente); liberado se o pedido for cancelado sem uso.
model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@map("coupon_redemptions")
}

/// Cartão salvo (ficha 49). Só guarda o token do cofre do gateway + bandeira/final/validade: nunca número nem CVV.
model SavedPaymentMethod {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  kind       PaymentMethod
  brand      String        @db.VarChar(20)
  last4      String        @db.Char(4)
  expMonth   Int           @map("exp_month") @db.SmallInt
  expYear    Int           @map("exp_year") @db.SmallInt
  holderName String        @map("holder_name") @db.VarChar(60)
  token      String        @unique @db.VarChar(128)
  /// Índice parcial (migration): no máximo um método padrão por usuário.
  isDefault  Boolean       @default(false) @map("is_default")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_payment_methods")
}

enum BookingStatus {
  confirmed
  refused
  cancelled
  seated

  @@map("booking_status")
}

/// Reserva de mesa feita pelo cliente (ficha 30): confirmada ou recusada na hora, conforme a disponibilidade.
model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  tableId         String?       @map("table_id") @db.Uuid
  partySize       Int           @map("party_size") @db.SmallInt
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(3)
  status          BookingStatus
  refusalReason   String?       @map("refusal_reason") @db.VarChar(120)
  /// Quem cancelou: nulo = cliente (ou recusa automática); preenchido = equipe.
  cancelledById   String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  table         DiningTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([establishmentId, startsAt])
  @@index([userId, startsAt(sort: Desc)])
  @@index([tableId, startsAt])
  @@map("bookings")
}

/// Avaliação de um pedido entregue (ficha 48): uma por pedido.
model Review {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @unique @map("order_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  rating          Int      @db.SmallInt
  comment         String   @default("") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, createdAt(sort: Desc)])
  @@map("reviews")
}

/// Acesso pelo link compartilhado da página do restaurante (ficha 62), com a origem para métricas de marketing.
model ShareVisit {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  source          String   @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, createdAt(sort: Desc)])
  @@map("share_visits")
}

/// Lote de insumo com validade (ficha 70).
model IngredientLot {
  id           String    @id @default(uuid()) @db.Uuid
  ingredientId String    @map("ingredient_id") @db.Uuid
  code         String    @db.VarChar(40)
  quantity     Decimal?  @db.Decimal(14, 4)
  /// Só a data (dia de validade, no calendário local da casa).
  expiresOn    DateTime  @map("expires_on") @db.Date
  /// Usado/descartado: sai do monitoramento e fecha o alerta.
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, code])
  @@index([expiresOn])
  @@map("ingredient_lots")
}

enum SupportPriority {
  low
  normal
  high
  urgent

  @@map("support_priority")
}

enum SupportStatus {
  open
  in_progress
  resolved

  @@map("support_status")
}

/// Chamado de suporte aberto por um estabelecimento (ficha 39).
model SupportTicket {
  id              String          @id @default(uuid()) @db.Uuid
  number          Int             @unique @default(autoincrement())
  establishmentId String          @map("establishment_id") @db.Uuid
  createdById     String?         @map("created_by_id") @db.Uuid
  subject         String          @db.VarChar(120)
  priority        SupportPriority @default(normal)
  status          SupportStatus   @default(open)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastMessageAt   DateTime        @default(now()) @map("last_message_at") @db.Timestamptz(3)
  resolvedAt      DateTime?       @map("resolved_at") @db.Timestamptz(3)

  establishment Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  createdBy     User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([status, priority, createdAt])
  @@index([establishmentId, createdAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  authorName String   @map("author_name") @db.VarChar(120)
  /// `platform` (admin) ou `establishment` (equipe da casa).
  side       String   @db.VarChar(20)
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

enum IntegrationKind {
  pdv
  erp
  delivery
  other

  @@map("integration_kind")
}

enum IntegrationStatus {
  unknown
  online
  offline

  @@map("integration_status")
}

/// Integração externa de um estabelecimento (ficha 33), como o PDV. Envia heartbeat com a chave do dispositivo;
/// sem sinal dentro do prazo (ou com falha informada) abre um incidente.
model Integration {
  id              String            @id @default(uuid()) @db.Uuid
  establishmentId String            @map("establishment_id") @db.Uuid
  name            String            @db.VarChar(60)
  kind            IntegrationKind
  /// SHA-256 da chave do dispositivo (mostrada uma única vez, na criação).
  keyHash         String            @map("key_hash") @db.Char(64)
  status          IntegrationStatus @default(unknown)
  lastSeenAt      DateTime?         @map("last_seen_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  incidents     Incident[]

  @@unique([establishmentId, name])
  @@index([keyHash])
  @@map("integrations")
}

/// Incidente de integração (ficha 33): histórico de auditoria, nunca apagado (trigger no banco).
/// Índice parcial (migration): um incidente aberto por integração.
model Incident {
  id              String    @id @default(uuid()) @db.Uuid
  integrationId   String    @map("integration_id") @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  /// `heartbeat_timeout` (sem sinal) ou `reported` (a própria integração informou a falha).
  cause           String    @db.VarChar(30)
  message         String    @db.VarChar(200)
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)

  integration   Integration   @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  @@index([resolvedAt])
  @@index([establishmentId, startedAt(sort: Desc)])
  @@map("incidents")
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled

  @@map("invoice_status")
}

/// Fatura mensal da plataforma para o estabelecimento (ficha 38). Única por (estabelecimento, período).
model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  number          Int           @unique @default(autoincrement())
  establishmentId String        @map("establishment_id") @db.Uuid
  /// Competência no formato AAAA-MM.
  period          String        @db.VarChar(7)
  planName        String        @map("plan_name") @db.VarChar(40)
  amountCents     Int           @map("amount_cents")
  dueDate         DateTime      @map("due_date") @db.Date
  status          InvoiceStatus @default(pending)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  paidById        String?       @map("paid_by_id") @db.Uuid
  paymentNote     String?       @map("payment_note") @db.VarChar(120)
  /// Último aviso de pendência enviado (primeiro no dia seguinte ao vencimento; depois a cada 3 dias).
  lastNotifiedAt  DateTime?     @map("last_notified_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  @@unique([establishmentId, period])
  @@index([status, dueDate])
  @@map("invoices")
}

/// Histórico de alterações do cadastro do estabelecimento (ficha 66). Somente inserção (trigger no banco).
model EstablishmentChange {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  actorId         String?  @map("actor_id") @db.Uuid
  actorName       String   @map("actor_name") @db.VarChar(120)
  field           String   @db.VarChar(40)
  oldValue        Json?    @map("old_value")
  newValue        Json?    @map("new_value")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  @@index([establishmentId, createdAt(sort: Desc)])
  @@map("establishment_changes")
}
