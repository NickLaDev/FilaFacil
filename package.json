{
  "name": "filafacil",
  "private": true,
  "description": "FilaFacil — monorepo com o frontend (apps/web) e a API (apps/api).",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @filafacil/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "preview": "pnpm --filter @filafacil/web preview"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.22.0"
}
